gitignore
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output/

# Build / output
dist/
out/
.next/
.nuxt/
.svelte-kit/
.docusaurus/
.vuepress/dist/
**/.vitepress/dist
.temp/
build/Release/

# Caches
.cache/
.parcel-cache/
web_modules/
.fusebox/
.eslintcache
.stylelintcache
.npm/

# Dependencies
node_modules/
jspm_packages/
bower_components/

# TypeScript
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# Package artifacts
*.tgz
.yarn-integrity

# Yarn v3 (Berry)
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Serverless / cloud
.serverless/
.vercel/

# Local databases / tools
.dynamodb/
.firebase/
.tern-port
.lock-wscript
lib-cov/

# Editor / OS
.vscode-test/
.DS_Store
Thumbs.db

# Node REPL history
.node_repl_history
